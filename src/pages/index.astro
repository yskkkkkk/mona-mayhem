			.legend-swatches {
				display: inline-flex;
				gap: 3px;
			}

			.legend-swatch {
				flex: 0 0 12px;
				width: 12px;
				height: 12px;
				border-radius: 2px;
			}

			.share-controls {
				margin: 0 auto 40px;
			}

			.share-controls button {
				width: auto;
			}

			#share-feedback {
				min-height: 1.8em;
				color: var(--color-green);
			}

			.history {
				margin-top: 56px;
				text-align: left;
			}

			.history h2 {
				color: var(--color-purple);
				font-size: 1rem;
				text-align: center;
			}

