<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a1a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem — GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="hero">
				<p class="eyebrow">INSERT COIN TO COMPARE</p>
				<h1>Mona Mayhem</h1>
				<p class="subtitle">GitHub Contribution Battle Arena</p>
				<button id="theme-toggle" class="utility-button" type="button" aria-pressed="false">
					⚡ Switch Theme
				</button>
				<button id="sound-toggle" class="utility-button" type="button" aria-pressed="true">
					🔇 Sound: Muted
				</button>
			</header>

			<form id="battle-form" novalidate>
				<div class="players">
					<div class="player-input">
						<label for="player-one">Player 1</label>
						<input id="player-one" name="player-one" autocomplete="off" spellcheck="false" placeholder="octocat" aria-describedby="player-one-error" aria-invalid="false" />
						<p class="input-error" id="player-one-error" aria-live="polite"></p>
					</div>
					<div class="player-input">
						<label for="player-two">Player 2</label>
						<input id="player-two" name="player-two" autocomplete="off" spellcheck="false" placeholder="torvalds" aria-describedby="player-two-error" aria-invalid="false" />
						<p class="input-error" id="player-two-error" aria-live="polite"></p>
					</div>
				</div>
				<button id="battle-button" type="submit">⚔ BATTLE ⚔</button>
			</form>

			<p id="storage-warning" class="result-error" role="status" aria-live="polite" aria-atomic="true"></p>
			<p id="audio-warning" class="result-error" role="status" aria-live="polite" aria-atomic="true"></p>
			<p id="loading" class="loading" role="status" aria-live="polite" hidden>Loading battle data...</p>
			<p id="battle-status" class="battle-status" role="status" aria-live="polite"></p>
			<div id="countdown-overlay" class="countdown-overlay" role="status" aria-live="assertive" hidden></div>
			<p id="winner-banner" class="winner-banner" role="status" aria-live="polite" hidden></p>

			<section id="results" class="results" aria-label="Battle results" hidden>
				<article class="result-card" id="player-one-card" aria-label="Player 1 contribution results">
					<div class="result-content" id="player-one-result"></div>
				</article>
				<div class="versus" aria-label="versus">VS</div>
				<article class="result-card" id="player-two-card" aria-label="Player 2 contribution results">
					<div class="result-content" id="player-two-result"></div>
				</article>
			</section>

			<div id="share-controls" class="share-controls" hidden>
				<button id="share-button" type="button">📋 Share Results</button>
				<p id="share-feedback" role="status" aria-live="polite"></p>
			</div>

			<section class="history" aria-labelledby="history-title">
				<h2 id="history-title">Recent Battles</h2>
				<ul id="battle-history" aria-live="polite"></ul>
				<button id="clear-history" class="utility-button" type="button">Clear History</button>
			</section>
		</main>

		<script>
			import type { ContributionData } from '../types/contributions';

			const form = document.querySelector<HTMLFormElement>('#battle-form')!;
			const playerOneInput = document.querySelector<HTMLInputElement>('#player-one')!;
			const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two')!;
			const battleButton = document.querySelector<HTMLButtonElement>('#battle-button')!;
			const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle')!;
			const soundToggle = document.querySelector<HTMLButtonElement>('#sound-toggle')!;
			const results = document.querySelector<HTMLElement>('#results')!;
			const playerOneResult = document.querySelector<HTMLElement>('#player-one-result')!;
			const playerTwoResult = document.querySelector<HTMLElement>('#player-two-result')!;
			const loading = document.querySelector<HTMLElement>('#loading')!;
			const status = document.querySelector<HTMLElement>('#battle-status')!;
			const storageWarning = document.querySelector<HTMLElement>('#storage-warning')!;
			const audioWarning = document.querySelector<HTMLElement>('#audio-warning')!;
			const countdownOverlay = document.querySelector<HTMLElement>('#countdown-overlay')!;
			const winnerBanner = document.querySelector<HTMLElement>('#winner-banner')!;
			const shareControls = document.querySelector<HTMLElement>('#share-controls')!;
			const shareButton = document.querySelector<HTMLButtonElement>('#share-button')!;
			const shareFeedback = document.querySelector<HTMLElement>('#share-feedback')!;
			const historyList = document.querySelector<HTMLUListElement>('#battle-history')!;
			const clearHistoryButton = document.querySelector<HTMLButtonElement>('#clear-history')!;
			const usernamePattern = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/;
			const root = document.documentElement;
			type BattleRecord = {
				playerOne: string;
				playerTwo: string;
				playerOneContributions: number;
				playerTwoContributions: number;
				winner: string;
				playedAt: string;
			};
			let muted = true;
			let audioContext: AudioContext | undefined;
			let lastBattle: BattleRecord | undefined;
			let battleInProgress = false;
			let shareAttempt = 0;
			let shareFeedbackTimer: number | undefined;
			const storageWarnings = { theme: '', history: '' };

			function showStorageWarning(kind: 'theme' | 'history', message: string): void {
				storageWarnings[kind] = message;
				storageWarning.textContent = Object.values(storageWarnings).filter(Boolean).join(' ');
			}

			themeToggle.addEventListener('click', () => {
				const isAlternate = root.dataset.theme !== 'alternate';
				if (isAlternate) {
					root.dataset.theme = 'alternate';
				} else {
					delete root.dataset.theme;
				}
				themeToggle.setAttribute('aria-pressed', String(isAlternate));
				try {
					if (isAlternate) {
						localStorage.setItem('mona-mayhem-theme', 'alternate');
					} else {
						localStorage.removeItem('mona-mayhem-theme');
					}
					showStorageWarning('theme', '');
				} catch {
					showStorageWarning('theme', 'Your theme could not be saved. Theme changes still work for this visit.');
				}
			});

			function updateSoundToggle(): void {
				soundToggle.setAttribute('aria-pressed', String(muted));
				soundToggle.textContent = muted ? '🔇 Sound: Muted' : '🔊 Sound: On';
			}

			function reportAudioFailure(): void {
				muted = true;
				updateSoundToggle();
				audioWarning.textContent = 'Sound is unavailable and has been muted. Battles still work without sound; try enabling it again.';
			}

			function playSound(kind: 'coin' | 'powerup' | 'error'): void {
				if (muted) return;
				try {
					if (!audioContext || audioContext.state !== 'running') {
						reportAudioFailure();
						return;
					}
					const context = audioContext;
					const notes =
						kind === 'coin'
							? [880, 1175]
							: kind === 'powerup'
								? [523, 659, 784, 1047]
								: [180, 110, 70];
					const wave: OscillatorType = kind === 'error' ? 'sawtooth' : 'square';
					notes.forEach((frequency, index) => {
						const oscillator = context.createOscillator();
						const gain = context.createGain();
						const startAt = context.currentTime + index * 0.09;
						oscillator.type = wave;
						oscillator.frequency.setValueAtTime(frequency, startAt);
						gain.gain.setValueAtTime(0.0001, startAt);
						gain.gain.exponentialRampToValueAtTime(0.12, startAt + 0.015);
						gain.gain.exponentialRampToValueAtTime(0.0001, startAt + 0.12);
						oscillator.connect(gain);
						gain.connect(context.destination);
						oscillator.start(startAt);
						oscillator.stop(startAt + 0.13);
					});
				} catch {
					reportAudioFailure();
				}
			}

			soundToggle.addEventListener('click', async () => {
				if (soundToggle.disabled) return;
				if (!muted) {
					muted = true;
					updateSoundToggle();
					return;
				}
				soundToggle.disabled = true;
				try {
					if (!audioContext || audioContext.state === 'closed') {
						audioContext = new AudioContext();
					}
					await audioContext.resume();
					if (audioContext.state !== 'running') {
						reportAudioFailure();
						return;
					}
					muted = false;
					audioWarning.textContent = '';
					updateSoundToggle();
				} catch {
					reportAudioFailure();
				} finally {
					soundToggle.disabled = false;
				}
			});

			function isObject(value: unknown): value is Record<string, unknown> {
				return typeof value === 'object' && value !== null && !Array.isArray(value);
			}

			function isCount(value: unknown): value is number {
				return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0;
			}

			function isBattleRecord(value: unknown): value is BattleRecord {
				if (
					!isObject(value) ||
					typeof value.playerOne !== 'string' || !usernamePattern.test(value.playerOne) ||
					typeof value.playerTwo !== 'string' || !usernamePattern.test(value.playerTwo) ||
					!isCount(value.playerOneContributions) || !isCount(value.playerTwoContributions) ||
					typeof value.playedAt !== 'string' || !Number.isFinite(Date.parse(value.playedAt))
				) return false;
				const winner = value.playerOneContributions === value.playerTwoContributions
					? 'Tie'
					: value.playerOneContributions > value.playerTwoContributions
						? value.playerOne
						: value.playerTwo;
				return value.winner === winner;
			}

			function readHistory(): { records: BattleRecord[]; canSave: boolean } {
				let raw: string | null;
				try {
					raw = localStorage.getItem('mona-mayhem-history');
				} catch {
					showStorageWarning('history', 'Battle history is unavailable. Battles still work, but history cannot be loaded or saved.');
					return { records: [], canSave: false };
				}
				let stored: unknown;
				try {
					stored = raw === null ? [] : JSON.parse(raw);
				} catch {
					showStorageWarning('history', 'Saved battle history is unreadable and has not been changed. Clear History to start saving again.');
					return { records: [], canSave: false };
				}
				if (!Array.isArray(stored)) {
					showStorageWarning('history', 'Saved battle history has an invalid format and has not been changed. Clear History to start saving again.');
					return { records: [], canSave: false };
				}
				const records = stored.filter(isBattleRecord);
				const canSave = records.length === stored.length;
				showStorageWarning('history', canSave
					? ''
					: 'Some saved battles are invalid. Showing valid entries only; saved history is unchanged. Clear History before saving new battles.');
				return { records: records.slice(0, 10), canSave };
			}

			function battleSummary(record: BattleRecord): string {
				const matchup = `${record.playerOne} (${record.playerOneContributions.toLocaleString()}) vs ${record.playerTwo} (${record.playerTwoContributions.toLocaleString()})`;
				return record.playerOneContributions === record.playerTwoContributions
					? `${matchup} — IT'S A TIE!`
					: `${matchup} — ${record.winner} wins!`;
			}

			function renderHistory(records: BattleRecord[]): void {
				historyList.replaceChildren();
				for (const record of records) {
					const item = document.createElement('li');
					const time = document.createElement('time');
					time.dateTime = record.playedAt;
					time.textContent = new Date(record.playedAt).toLocaleString();
					item.textContent = `${battleSummary(record)} `;
					item.append(time);
					historyList.append(item);
				}
			}

			function saveBattle(record: BattleRecord): void {
				const stored = readHistory();
				if (!stored.canSave) return;
				const history = [record, ...stored.records].slice(0, 10);
				try {
					localStorage.setItem('mona-mayhem-history', JSON.stringify(history));
				} catch {
					showStorageWarning('history', 'This battle could not be saved to history. Check browser storage permissions or free up space.');
					return;
				}
				renderHistory(history);
			}

			clearHistoryButton.addEventListener('click', () => {
				try {
					localStorage.removeItem('mona-mayhem-history');
					showStorageWarning('history', '');
					renderHistory([]);
				} catch {
					showStorageWarning('history', 'Saved battle history could not be cleared. Check browser storage permissions and try again.');
				}
			});

			function resetShareFeedback(): void {
				shareAttempt++;
				window.clearTimeout(shareFeedbackTimer);
				shareFeedbackTimer = undefined;
				shareFeedback.textContent = '';
			}

			shareButton.addEventListener('click', async () => {
				if (!lastBattle) return;
				resetShareFeedback();
				const attempt = shareAttempt;
				const summary = battleSummary(lastBattle);
				try {
					await navigator.clipboard.writeText(summary);
					if (attempt !== shareAttempt) return;
					shareFeedback.textContent = 'Copied to clipboard!';
				} catch {
					if (attempt !== shareAttempt) return;
					shareFeedback.textContent = 'Could not copy results to clipboard.';
				}
				shareFeedbackTimer = window.setTimeout(() => {
					if (attempt === shareAttempt) shareFeedback.textContent = '';
					shareFeedbackTimer = undefined;
				}, 2500);
			});

			type PlayerResult = { username: string; data?: ContributionData; error?: string };

			function showInputError(input: HTMLInputElement, message: string): void {
				const error = document.querySelector<HTMLElement>(`#${input.id}-error`)!;
				error.textContent = message;
				input.setAttribute('aria-invalid', message ? 'true' : 'false');
				error.classList.remove('shake');
				if (message) {
					void error.offsetWidth;
					error.classList.add('shake');
				}
			}

			function isCalendarDate(value: unknown): value is string {
				if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
				const date = new Date(`${value}T00:00:00Z`);
				return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
			}

			function isContributionData(value: unknown): value is ContributionData {
				if (!isObject(value)) return false;
				const colors = value.colors_full;
				return (
					typeof value.schema === 'string' && value.schema.length > 0 &&
					typeof value.generated_at === 'string' && Number.isFinite(Date.parse(value.generated_at)) &&
					isCalendarDate(value.from) && isCalendarDate(value.to) && value.from <= value.to &&
					isCount(value.range_days) && value.range_days > 0 &&
					isCount(value.total_contributions) &&
					typeof value.private_contributions_included === 'boolean' &&
					Array.isArray(colors) && colors.length > 0 &&
					colors.every((color) => typeof color === 'string' && color.trim().length > 0) &&
					Array.isArray(value.weeks) && value.weeks.length > 0 &&
					value.weeks.every((week) =>
						isObject(week) && isCount(week.index) && isCalendarDate(week.first_day) &&
						Array.isArray(week.contribution_days) && week.contribution_days.length <= 7 &&
						week.contribution_days.every((day) =>
							isObject(day) && isCount(day.weekday) && day.weekday <= 6 &&
							isCount(day.count) && isCount(day.level) && day.level < colors.length,
						) &&
						new Set(week.contribution_days.map((day) => day.weekday)).size === week.contribution_days.length,
					) &&
					Array.isArray(value.months) &&
					value.months.every((month) =>
						isObject(month) && typeof month.month === 'string' && isCount(month.total_weeks),
					)
				);
			}

			async function fetchPlayer(username: string): Promise<PlayerResult> {
				try {
					const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
					const body: unknown = await response.json();
					if (!response.ok) {
						return {
							username,
							error: isObject(body) && typeof body.error === 'string' && body.error.trim()
								? body.error
								: 'Unable to load contributions.',
						};
					}
					if (!isContributionData(body)) {
						return { username, error: 'The contribution service returned invalid data. Please try again.' };
					}
					return { username, data: body };
				} catch {
					return { username, error: 'Unable to reach the contribution service.' };
				}
			}

			function longestStreak(data: ContributionData): number {
				let current = 0;
				let longest = 0;
				for (const week of data.weeks) {
					for (let weekday = 0; weekday < 7; weekday++) {
						const day = week.contribution_days.find((entry) => entry.weekday === weekday);
						current = day && day.count > 0 ? current + 1 : 0;
						longest = Math.max(longest, current);
					}
				}
				return longest;
			}

			function renderPlayer(target: HTMLElement, result: PlayerResult, hasLongestStreak: boolean): void {
				target.querySelector<HTMLElement>('.graph-tooltip:popover-open')?.hidePopover();
				target.replaceChildren();
				if (!result.data) {
					const error = document.createElement('p');
					error.className = 'result-error';
					error.textContent = `${result.username}: ${result.error ?? 'Unable to load contributions.'}`;
					target.append(error);
					return;
				}

				const { data } = result;
				const username = document.createElement('h2');
				username.textContent = result.username;
				const total = document.createElement('p');
				total.className = 'total';
				total.textContent = `${data.total_contributions.toLocaleString()} contributions`;
				const range = document.createElement('p');
				range.className = 'date-range';
				range.textContent = `${data.from} — ${data.to}`;
				const streak = document.createElement('p');
				streak.className = `streak${hasLongestStreak ? ' longest-streak' : ''}`;
				streak.textContent = `🔥 Longest Streak: ${longestStreak(data)} days`;
				const graphRegion = document.createElement('div');
				graphRegion.className = 'graph-region';
				const instructions = document.createElement('p');
				instructions.className = 'graph-instructions';
				instructions.id = `${target.id}-graph-instructions`;
				instructions.textContent =
					'Arrow keys: left/right week, up/down day. Home/End: first/last date. Tab: exit. Esc: hide details.';
				const graphViewport = document.createElement('div');
				graphViewport.className = 'graph-viewport';
				graphViewport.tabIndex = -1;
				graphViewport.setAttribute('role', 'group');
				graphViewport.setAttribute(
					'aria-label',
					`${result.username}: ${data.total_contributions} contributions from ${data.from} to ${data.to}`,
				);
				graphViewport.setAttribute('aria-describedby', instructions.id);
				const graph = document.createElement('div');
				graph.className = 'contribution-graph';
				graph.style.gridTemplateColumns = `repeat(${data.weeks.length}, 12px)`;
				const squares: HTMLElement[] = [];
				const tooltip = document.createElement('p');
				tooltip.id = `${target.id}-graph-tooltip`;
				tooltip.className = 'graph-tooltip';
				tooltip.setAttribute('role', 'tooltip');
				tooltip.setAttribute('popover', 'manual');
				tooltip.hidden = true;

				for (const week of data.weeks) {
					for (let weekday = 0; weekday < 7; weekday++) {
						const day = week.contribution_days.find((entry) => entry.weekday === weekday);
						const square = document.createElement('span');
						square.className = 'contribution-day';
						square.style.backgroundColor = data.colors_full[day?.level ?? 0] ?? data.colors_full[0];
						square.style.color = square.style.backgroundColor;
						const date = new Date(`${week.first_day}T00:00:00Z`);
						date.setUTCDate(date.getUTCDate() + weekday);
						const dateLabel = date.toISOString().slice(0, 10);
						const count = day?.count ?? 0;
						square.dataset.tooltip = `${dateLabel}: ${count} contributions`;
						square.setAttribute('role', 'img');
						square.setAttribute('aria-label', square.dataset.tooltip);
						square.tabIndex = squares.length === 0 ? 0 : -1;
						squares.push(square);
						graph.append(square);
					}
				}

				let activeIndex = 0;
				let hoveredSquare: HTMLElement | undefined;
				let focusedSquare: HTMLElement | undefined;
				let tooltipSquare: HTMLElement | undefined;
				let tooltipDismissed = false;
				let tooltipViewportEvents: AbortController | undefined;

				function positionTooltip(): void {
					if (!tooltipSquare || !tooltip.isConnected) return;
					const viewportWidth = document.documentElement.clientWidth;
					const viewportHeight = window.innerHeight;
					tooltip.style.maxWidth = `${viewportWidth - 16}px`;
					const cellBounds = tooltipSquare.getBoundingClientRect();
					const tooltipBounds = tooltip.getBoundingClientRect();
					const left = cellBounds.left + (cellBounds.width - tooltipBounds.width) / 2;
					const above = cellBounds.top - tooltipBounds.height - 8;
					const top = above >= 8 ? above : cellBounds.bottom + 8;
					tooltip.style.left = `${Math.max(8, Math.min(left, viewportWidth - tooltipBounds.width - 8))}px`;
					tooltip.style.top = `${Math.max(8, Math.min(top, viewportHeight - tooltipBounds.height - 8))}px`;
				}

				tooltip.addEventListener('beforetoggle', (event) => {
					if ((event as ToggleEvent).newState === 'closed') {
						tooltipViewportEvents?.abort();
						tooltipViewportEvents = undefined;
					}
				});

				function showTooltip(square?: HTMLElement): void {
					tooltipSquare?.removeAttribute('aria-describedby');
					tooltipSquare = tooltipDismissed ? undefined : square;
					tooltip.textContent = tooltipSquare?.dataset.tooltip ?? '';
					if (!tooltipSquare && tooltip.matches(':popover-open')) tooltip.hidePopover();
					tooltip.hidden = !tooltipSquare;
					if (!tooltipSquare) return;
					tooltipSquare.setAttribute('aria-describedby', tooltip.id);
					if (!tooltip.matches(':popover-open')) {
						tooltip.showPopover();
						tooltipViewportEvents = new AbortController();
						const { signal } = tooltipViewportEvents;
						window.addEventListener('scroll', positionTooltip, { capture: true, signal });
						window.addEventListener('resize', positionTooltip, { signal });
					}
					positionTooltip();
				}

				function eventSquare(event: Event): HTMLElement | undefined {
					const square = event.target;
					return square instanceof HTMLElement && square.classList.contains('contribution-day')
						? square
						: undefined;
				}

				graph.addEventListener('pointerover', (event) => {
					const square = eventSquare(event);
					if (!square) return;
					hoveredSquare = square;
					tooltipDismissed = false;
					showTooltip(square);
				});
				graphRegion.addEventListener('pointerleave', () => {
					hoveredSquare = undefined;
					showTooltip(focusedSquare);
				});
				graph.addEventListener('focusin', (event) => {
					const square = eventSquare(event);
					if (!square) return;
					squares[activeIndex].tabIndex = -1;
					activeIndex = squares.indexOf(square);
					square.tabIndex = 0;
					focusedSquare = square;
					tooltipDismissed = false;
					showTooltip(square);
				});
				graph.addEventListener('focusout', () => {
					focusedSquare = undefined;
					showTooltip(hoveredSquare);
				});
				graph.addEventListener('keydown', (event) => {
					if (!eventSquare(event) || event.altKey || event.ctrlKey || event.metaKey) return;
					if (event.key === 'Escape') {
						tooltipDismissed = true;
						showTooltip();
						event.preventDefault();
						return;
					}
					let nextIndex = activeIndex;
					switch (event.key) {
						case 'ArrowLeft':
							if (activeIndex >= 7) nextIndex -= 7;
							break;
						case 'ArrowRight':
							if (activeIndex + 7 < squares.length) nextIndex += 7;
							break;
						case 'ArrowUp':
							if (activeIndex % 7 > 0) nextIndex--;
							break;
						case 'ArrowDown':
							if (activeIndex % 7 < 6) nextIndex++;
							break;
						case 'Home':
							nextIndex = 0;
							break;
						case 'End':
							nextIndex = squares.length - 1;
							break;
						default:
							return;
					}
					event.preventDefault();
					squares[nextIndex].focus({ preventScroll: true });
					squares[nextIndex].scrollIntoView({ block: 'nearest', inline: 'nearest' });
				});

				graphViewport.append(graph);
				graphRegion.append(instructions, graphViewport, tooltip);
				const legend = document.createElement('div');
				legend.className = 'legend';
				const less = document.createElement('span');
				less.textContent = 'Less';
				const more = document.createElement('span');
				more.textContent = 'More';
				const swatches = document.createElement('span');
				swatches.className = 'legend-swatches';
				for (const color of data.colors_full) {
					const swatch = document.createElement('span');
					swatch.className = 'legend-swatch';
					swatch.style.backgroundColor = color;
					swatches.append(swatch);
				}
				legend.append(less, swatches, more);
				target.append(username, total, range, graphRegion, streak, legend);
			}

			async function runCountdown(): Promise<void> {
				countdownOverlay.hidden = false;
				try {
					for (const text of ['3...', '2...', '1...', '⚡ FIGHT! ⚡']) {
						countdownOverlay.textContent = text;
						await new Promise((resolve) => window.setTimeout(resolve, 1000));
					}
				} finally {
					countdownOverlay.hidden = true;
					countdownOverlay.textContent = '';
				}
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (battleInProgress) {
					status.textContent = 'A battle is already in progress. Please wait.';
					return;
				}
				const usernames = [playerOneInput, playerTwoInput].map((input) => input.value.trim());
				const inputs = [playerOneInput, playerTwoInput];
				let valid = true;

				inputs.forEach((input, index) => {
					const username = usernames[index];
					const message = !username
						? 'Please enter a GitHub username.'
						: !usernamePattern.test(username)
							? 'Use 1–39 letters, numbers, or hyphens; no leading or trailing hyphen.'
							: '';
					showInputError(input, message);
					if (message) valid = false;
				});

				if (!valid) {
					status.textContent = '';
					winnerBanner.hidden = true;
					shareControls.hidden = true;
					lastBattle = undefined;
					resetShareFeedback();
					inputs.find((input) => input.getAttribute('aria-invalid') === 'true')?.focus();
					playSound('error');
					return;
				}

				battleInProgress = true;
				try {
					battleButton.disabled = true;
					loading.hidden = false;
					status.textContent = '';
					winnerBanner.hidden = true;
					winnerBanner.textContent = '';
					shareControls.hidden = true;
					results.hidden = true;
					lastBattle = undefined;
					resetShareFeedback();
					playerOneResult.replaceChildren();
					playerTwoResult.replaceChildren();
					playSound('coin');

					const [players] = await Promise.all([
						Promise.all(usernames.map((username) => fetchPlayer(username))),
						runCountdown(),
					]);
					const streaks = players.map((player) => player.data ? longestStreak(player.data) : 0);
					results.hidden = false;
					players.forEach((player, index) => {
						const target = [playerOneResult, playerTwoResult][index];
						try {
							renderPlayer(target, player, streaks[index] > streaks[1 - index]);
						} catch {
							const error = 'Unable to display contributions. Please try again.';
							players[index] = { username: player.username, error };
							const message = document.createElement('p');
							message.className = 'result-error';
							message.textContent = `${player.username}: ${error}`;
							target.replaceChildren(message);
						}
					});
					const [one, two] = players;
					if (!one.data || !two.data) {
						status.textContent = players.map((player) => player.data
							? `${player.username}: ${player.data.total_contributions.toLocaleString()} contributions.`
							: `${player.username}: ${player.error ?? 'Unable to load contributions.'}`,
						).join(' ') + ' No winner could be determined. Please try again.';
						playSound('error');
						return;
					}

					const isTie = one.data.total_contributions === two.data.total_contributions;
					const winner = isTie
						? 'Tie'
						: one.data.total_contributions > two.data.total_contributions
							? one.username
							: two.username;
					winnerBanner.textContent = isTie ? "🤝 IT'S A TIE! 🤝" : `🏆 ${winner} WINS! 🏆`;
					winnerBanner.hidden = false;
					shareControls.hidden = false;
					const record: BattleRecord = {
						playerOne: one.username,
						playerTwo: two.username,
						playerOneContributions: one.data.total_contributions,
						playerTwoContributions: two.data.total_contributions,
						winner,
						playedAt: new Date().toISOString(),
					};
					lastBattle = record;
					status.textContent = battleSummary(record);
					saveBattle(record);
					playSound('powerup');
				} catch {
					winnerBanner.hidden = true;
					shareControls.hidden = true;
					lastBattle = undefined;
					status.textContent = 'The battle could not finish. Please try again.';
					playSound('error');
				} finally {
					battleInProgress = false;
					battleButton.disabled = false;
					loading.hidden = true;
					countdownOverlay.hidden = true;
					countdownOverlay.textContent = '';
				}
			});

			try {
				const savedTheme = localStorage.getItem('mona-mayhem-theme');
				if (savedTheme === 'alternate') {
					root.dataset.theme = 'alternate';
					themeToggle.setAttribute('aria-pressed', 'true');
				} else if (savedTheme !== null) {
					showStorageWarning('theme', 'The saved theme is invalid. Using the default theme until you choose a theme.');
				}
			} catch {
				showStorageWarning('theme', 'Saved theme preferences are unavailable. Theme changes still work for this visit.');
			}
			renderHistory(readHistory().records);
		</script>

		<style is:global>
			:root {
				--color-background: #0a0a1a;
