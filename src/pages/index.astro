				overflow-wrap: anywhere;
			}

			.eyebrow,
			label,
			button {
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1 {
				margin: 20px 0;
				font-size: clamp(2rem, 6vw, 4rem);
