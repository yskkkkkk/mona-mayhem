---
import type { ContributionData } from '../types/contributions';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a1a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem — GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="hero">
				<p class="eyebrow">INSERT COIN TO COMPARE</p>
				<h1>Mona Mayhem</h1>
				<p class="subtitle">GitHub Contribution Battle Arena</p>
				<button id="theme-toggle" class="utility-button" type="button" aria-pressed="false">
					⚡ Switch Theme
				</button>
				<button id="sound-toggle" class="utility-button" type="button" aria-pressed="true">
					🔇 Sound: Muted
				</button>
			</header>

			<form id="battle-form" novalidate>
				<div class="players">
					<div class="player-input">
						<label for="player-one">Player 1</label>
						<input id="player-one" name="player-one" autocomplete="off" spellcheck="false" placeholder="octocat" aria-describedby="player-one-error" aria-invalid="false" />
						<p class="input-error" id="player-one-error" aria-live="polite"></p>
					</div>
					<div class="player-input">
						<label for="player-two">Player 2</label>
						<input id="player-two" name="player-two" autocomplete="off" spellcheck="false" placeholder="torvalds" aria-describedby="player-two-error" aria-invalid="false" />
						<p class="input-error" id="player-two-error" aria-live="polite"></p>
					</div>
				</div>
				<button id="battle-button" type="submit">⚔ BATTLE ⚔</button>
			</form>

			<p id="loading" class="loading" role="status" aria-live="polite" hidden>Loading battle data...</p>
			<p id="battle-status" class="battle-status" role="status" aria-live="polite"></p>
			<div id="countdown-overlay" class="countdown-overlay" role="status" aria-live="assertive" hidden></div>
			<p id="winner-banner" class="winner-banner" role="status" aria-live="polite" hidden></p>

			<section id="results" class="results" aria-label="Battle results" aria-live="polite" hidden>
				<article class="result-card" id="player-one-card" aria-label="Player 1 contribution results">
					<div class="result-content" id="player-one-result"></div>
				</article>
				<div class="versus" aria-label="versus">VS</div>
				<article class="result-card" id="player-two-card" aria-label="Player 2 contribution results">
					<div class="result-content" id="player-two-result"></div>
				</article>
			</section>

			<div id="share-controls" class="share-controls" hidden>
				<button id="share-button" type="button">📋 Share Results</button>
				<p id="share-feedback" role="status" aria-live="polite"></p>
			</div>

			<section class="history" aria-labelledby="history-title">
				<h2 id="history-title">Recent Battles</h2>
				<ul id="battle-history" aria-live="polite"></ul>
				<button id="clear-history" class="utility-button" type="button">Clear History</button>
			</section>
		</main>

		<script>
			import type { ContributionData } from '../types/contributions';

			const form = document.querySelector<HTMLFormElement>('#battle-form')!;
			const playerOneInput = document.querySelector<HTMLInputElement>('#player-one')!;
			const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two')!;
			const battleButton = document.querySelector<HTMLButtonElement>('#battle-button')!;
			const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle')!;
			const soundToggle = document.querySelector<HTMLButtonElement>('#sound-toggle')!;
			const results = document.querySelector<HTMLElement>('#results')!;
			const loading = document.querySelector<HTMLElement>('#loading')!;
			const status = document.querySelector<HTMLElement>('#battle-status')!;
			const countdownOverlay = document.querySelector<HTMLElement>('#countdown-overlay')!;
			const winnerBanner = document.querySelector<HTMLElement>('#winner-banner')!;
			const shareControls = document.querySelector<HTMLElement>('#share-controls')!;
			const shareButton = document.querySelector<HTMLButtonElement>('#share-button')!;
			const shareFeedback = document.querySelector<HTMLElement>('#share-feedback')!;
			const historyList = document.querySelector<HTMLUListElement>('#battle-history')!;
			const clearHistoryButton = document.querySelector<HTMLButtonElement>('#clear-history')!;
			const usernamePattern = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/;
			const root = document.documentElement;
			type BattleRecord = {
				playerOne: string;
				playerTwo: string;
				playerOneContributions: number;
				playerTwoContributions: number;
				winner: string;
				playedAt: string;
			};
			let muted = true;
			let audioContext: AudioContext | undefined;
			let lastBattle: BattleRecord | undefined;

			const savedTheme = localStorage.getItem('mona-mayhem-theme');
			if (savedTheme === 'alternate') {
				root.dataset.theme = 'alternate';
				themeToggle.setAttribute('aria-pressed', 'true');
				themeToggle.textContent = '⚡ Switch Theme';
			}

			themeToggle.addEventListener('click', () => {
				const isAlternate = root.dataset.theme !== 'alternate';
				if (isAlternate) {
					root.dataset.theme = 'alternate';
					localStorage.setItem('mona-mayhem-theme', 'alternate');
				} else {
					delete root.dataset.theme;
					localStorage.removeItem('mona-mayhem-theme');
				}
				themeToggle.setAttribute('aria-pressed', String(isAlternate));
			});

			function playSound(kind: 'coin' | 'powerup' | 'error'): void {
				if (muted) return;
				audioContext ??= new AudioContext();
				const notes =
					kind === 'coin'
						? [880, 1175]
						: kind === 'powerup'
							? [523, 659, 784, 1047]
							: [180, 110, 70];
				const wave: OscillatorType = kind === 'error' ? 'sawtooth' : 'square';
				notes.forEach((frequency, index) => {
					const oscillator = audioContext!.createOscillator();
					const gain = audioContext!.createGain();
					const startAt = audioContext!.currentTime + index * 0.09;
					oscillator.type = wave;
					oscillator.frequency.setValueAtTime(frequency, startAt);
					gain.gain.setValueAtTime(0.0001, startAt);
					gain.gain.exponentialRampToValueAtTime(0.12, startAt + 0.015);
					gain.gain.exponentialRampToValueAtTime(0.0001, startAt + 0.12);
					oscillator.connect(gain);
					gain.connect(audioContext!.destination);
					oscillator.start(startAt);
					oscillator.stop(startAt + 0.13);
				});
			}

			soundToggle.addEventListener('click', () => {
				muted = !muted;
				soundToggle.setAttribute('aria-pressed', String(muted));
				soundToggle.textContent = muted ? '🔇 Sound: Muted' : '🔊 Sound: On';
			});

			function readHistory(): BattleRecord[] {
				try {
					const stored: unknown = JSON.parse(localStorage.getItem('mona-mayhem-history') ?? '[]');
					return Array.isArray(stored) ? (stored as BattleRecord[]) : [];
				} catch {
					return [];
				}
			}

			function renderHistory(): void {
				historyList.replaceChildren();
				for (const record of readHistory()) {
					const item = document.createElement('li');
					const time = document.createElement('time');
					time.dateTime = record.playedAt;
					time.textContent = new Date(record.playedAt).toLocaleString();
					item.textContent = `${record.playerOne} (${record.playerOneContributions.toLocaleString()}) vs ${record.playerTwo} (${record.playerTwoContributions.toLocaleString()}) — ${record.winner} `;
					item.append(time);
					historyList.append(item);
				}
			}

			function saveBattle(record: BattleRecord): void {
				const history = [record, ...readHistory()].slice(0, 10);
				localStorage.setItem('mona-mayhem-history', JSON.stringify(history));
				renderHistory();
			}

			clearHistoryButton.addEventListener('click', () => {
				localStorage.removeItem('mona-mayhem-history');
				renderHistory();
			});
			renderHistory();

			shareButton.addEventListener('click', async () => {
				if (!lastBattle) return;
				const summary =
					lastBattle.winner === 'Tie'
						? `🤝 ${lastBattle.playerOne} vs ${lastBattle.playerTwo}: IT'S A TIE! 🤝`
						: `🏆 ${lastBattle.winner} wins! ${lastBattle.playerOne} (${lastBattle.playerOneContributions.toLocaleString()}) vs ${lastBattle.playerTwo} (${lastBattle.playerTwoContributions.toLocaleString()}) 🏆`;
				try {
					await navigator.clipboard.writeText(summary);
					shareFeedback.textContent = 'Copied to clipboard!';
				} catch {
					shareFeedback.textContent = 'Could not copy results to clipboard.';
				}
				window.setTimeout(() => (shareFeedback.textContent = ''), 2500);
			});

			type PlayerResult = { username: string; data?: ContributionData; error?: string };

			function showInputError(input: HTMLInputElement, message: string): void {
				const error = document.querySelector<HTMLElement>(`#${input.id}-error`)!;
				error.textContent = message;
				input.setAttribute('aria-invalid', message ? 'true' : 'false');
				error.classList.remove('shake');
				if (message) {
					void error.offsetWidth;
					error.classList.add('shake');
				}
			}

			async function fetchPlayer(username: string): Promise<PlayerResult> {
				try {
					const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
					const body = (await response.json()) as ContributionData | { error: string };
					if (!response.ok) {
						return {
							username,
							error: 'error' in body ? body.error : 'Unable to load contributions.',
						};
					}
					return { username, data: body as ContributionData };
				} catch {
					return { username, error: 'Unable to reach the contribution service.' };
				}
			}

			function longestStreak(data: ContributionData): number {
				let current = 0;
				let longest = 0;
				for (const week of data.weeks) {
					for (let weekday = 0; weekday < 7; weekday++) {
						const day = week.contribution_days.find((entry) => entry.weekday === weekday);
						current = day && day.count > 0 ? current + 1 : 0;
						longest = Math.max(longest, current);
					}
				}
				return longest;
			}

			function renderPlayer(target: HTMLElement, result: PlayerResult, hasLongestStreak: boolean): void {
				target.replaceChildren();
				if (!result.data) {
					const error = document.createElement('p');
					error.className = 'result-error';
					error.textContent = `${result.username}: ${result.error ?? 'Unable to load contributions.'}`;
					target.append(error);
					return;
				}

				const { data } = result;
				const username = document.createElement('h2');
				username.textContent = result.username;
				const total = document.createElement('p');
				total.className = 'total';
				total.textContent = `${data.total_contributions.toLocaleString()} contributions`;
				const range = document.createElement('p');
				range.className = 'date-range';
				range.textContent = `${data.from} — ${data.to}`;
				const streak = document.createElement('p');
				streak.className = `streak${hasLongestStreak ? ' longest-streak' : ''}`;
				streak.textContent = `🔥 Longest Streak: ${longestStreak(data)} days`;
				const graphViewport = document.createElement('div');
				graphViewport.className = 'graph-viewport';
				graphViewport.setAttribute('role', 'group');
				graphViewport.setAttribute(
					'aria-label',
					`${result.username}: ${data.total_contributions} contributions from ${data.from} to ${data.to}`,
				);
				const graph = document.createElement('div');
				graph.className = 'contribution-graph';
				graph.style.gridTemplateColumns = `repeat(${data.weeks.length}, 12px)`;

				for (const week of data.weeks) {
					for (let weekday = 0; weekday < 7; weekday++) {
						const day = week.contribution_days.find((entry) => entry.weekday === weekday);
						const square = document.createElement('span');
						square.className = 'contribution-day';
						square.style.backgroundColor = data.colors_full[day?.level ?? 0] ?? data.colors_full[0];
						const date = new Date(`${week.first_day}T00:00:00`);
						date.setDate(date.getDate() + weekday);
						const dateLabel = date.toISOString().slice(0, 10);
						const count = day?.count ?? 0;
						square.title = `${dateLabel}: ${count} contributions`;
						square.setAttribute('aria-label', square.title);
						square.dataset.tooltip = square.title;
						square.tabIndex = 0;
						graph.append(square);
					}
				}

				graphViewport.append(graph);
				const legend = document.createElement('div');
				legend.className = 'legend';
				const less = document.createElement('span');
				less.textContent = 'Less';
				const more = document.createElement('span');
				more.textContent = 'More';
				const swatches = document.createElement('span');
				swatches.className = 'legend-swatches';
				for (const color of data.colors_full) {
					const swatch = document.createElement('span');
					swatch.className = 'legend-swatch';
					swatch.style.backgroundColor = color;
					swatches.append(swatch);
				}
				legend.append(less, swatches, more);
				target.append(username, total, range, graphViewport, streak, legend);
			}

			async function runCountdown(): Promise<void> {
				countdownOverlay.hidden = false;
				for (const text of ['3...', '2...', '1...', '⚡ FIGHT! ⚡']) {
					countdownOverlay.textContent = text;
					await new Promise((resolve) => window.setTimeout(resolve, 1000));
				}
				countdownOverlay.hidden = true;
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const usernames = [playerOneInput, playerTwoInput].map((input) => input.value.trim());
				const inputs = [playerOneInput, playerTwoInput];
				let valid = true;

				inputs.forEach((input, index) => {
					const username = usernames[index];
					const message = !username
						? 'Please enter a GitHub username.'
						: !usernamePattern.test(username)
							? 'Use 1–39 letters, numbers, or hyphens; no leading or trailing hyphen.'
							: '';
					showInputError(input, message);
					if (message) valid = false;
				});

				if (!valid) {
					status.textContent = '';
					inputs.find((input) => input.getAttribute('aria-invalid') === 'true')?.focus();
					playSound('error');
					return;
				}

				battleButton.disabled = true;
				loading.hidden = false;
				status.textContent = '';
				winnerBanner.hidden = true;
				shareControls.hidden = true;
				results.hidden = true;
				playSound('coin');

				const resultsPromise = Promise.all(usernames.map((username) => fetchPlayer(username)));
				await runCountdown();
				const [one, two] = await resultsPromise;
				const oneStreak = one.data ? longestStreak(one.data) : 0;
				const twoStreak = two.data ? longestStreak(two.data) : 0;
				renderPlayer(document.querySelector<HTMLElement>('#player-one-result')!, one, oneStreak > twoStreak);
				renderPlayer(document.querySelector<HTMLElement>('#player-two-result')!, two, twoStreak > oneStreak);
				results.hidden = false;
				loading.hidden = true;
				battleButton.disabled = false;

				if (!one.data || !two.data) {
					status.textContent = 'One or both fighters could not load. Check the player cards and try again.';
					playSound('error');
					return;
				}

				const winner =
					one.data.total_contributions === two.data.total_contributions
						? 'Tie'
						: one.data.total_contributions > two.data.total_contributions
							? one.username
							: two.username;
				winnerBanner.textContent =
					winner === 'Tie' ? "🤝 IT'S A TIE! 🤝" : `🏆 ${winner} WINS! 🏆`;
				winnerBanner.hidden = false;
				shareControls.hidden = false;
				status.textContent = '';
				const record: BattleRecord = {
					playerOne: one.username,
					playerTwo: two.username,
					playerOneContributions: one.data.total_contributions,
					playerTwoContributions: two.data.total_contributions,
					winner,
					playedAt: new Date().toISOString(),
				};
				lastBattle = record;
				saveBattle(record);
				playSound('powerup');
			});
		</script>

		<style>
			:root {
				--color-background: #0a0a1a;
				--color-surface: #15152b;
				--color-green: #5fed83;
				--color-purple: #8a2be2;
				--color-error: #ff3366;
				--color-text: #f5f5f5;
				font-family: 'Press Start 2P', monospace;
				color: var(--color-text);
				background: var(--color-background);
				font-size: 12px;
				line-height: 1.8;
			}

			:root[data-theme='alternate'] {
				--color-green: #00f5ff;
				--color-purple: #ff6b35;
			}

			* {
				box-sizing: border-box;
			}

			[hidden] {
				display: none !important;
			}

			body {
				margin: 0;
				min-height: 100vh;
			}

			body::before {
				position: fixed;
				z-index: 10;
				inset: 0;
				background: repeating-linear-gradient(
					to bottom,
					transparent 0,
					transparent 2px,
					rgb(0 0 0 / 30%) 3px,
					transparent 4px
				);
				content: '';
				opacity: 0.03;
				pointer-events: none;
			}

			.arena {
				position: relative;
				width: min(1100px, 100%);
				margin: 0 auto;
				padding: 64px 24px;
				text-align: center;
			}

			.hero,
			#battle-form,
			.results,
			.loading,
			.battle-status {
				margin-bottom: 36px;
			}

			.eyebrow,
			label,
			button {
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1 {
				margin: 20px 0;
				font-size: clamp(2rem, 6vw, 4rem);
				color: var(--color-green);
				text-shadow: 0 0 12px var(--color-green), 0 0 32px rgb(95 237 131 / 60%);
				animation: title-pulse 3s ease-in-out infinite, electric-flicker 7s linear infinite;
			}

			.subtitle {
				font-size: 1.1rem;
				color: var(--color-purple);
			}

			.players {
				display: flex;
				gap: 24px;
				margin-bottom: 24px;
				text-align: left;
			}

			.player-input {
				flex: 1;
				animation: float-in 600ms ease-out both;
			}

			.player-input:nth-child(2) {
				animation-delay: 120ms;
			}

			label {
				display: block;
				margin-bottom: 10px;
			}

			input,
			button {
				width: 100%;
				padding: 14px;
				color: inherit;
				background: var(--color-surface);
				border: 1px solid var(--color-green);
				border-radius: 8px;
				font: inherit;
				transition: box-shadow 180ms ease, border-color 180ms ease;
			}

			input:focus,
			button:hover {
				border-color: var(--color-purple);
				box-shadow: 0 0 14px rgb(138 43 226 / 65%);
				outline: none;
			}

			button {
				width: auto;
				min-width: 220px;
				cursor: pointer;
				color: var(--color-green);
				box-shadow: 0 0 12px rgb(95 237 131 / 30%);
			}

			button:disabled {
				cursor: wait;
				opacity: 0.6;
			}

			button:focus-visible,
			input:focus-visible,
			.contribution-day:focus-visible {
				outline: 3px solid var(--color-purple);
				outline-offset: 4px;
			}

			.utility-button {
				min-width: 0;
				margin-top: 12px;
				padding: 10px 14px;
				font-size: 0.7rem;
			}

			.input-error,
			.result-error {
				color: var(--color-error);
				text-shadow: 0 0 10px var(--color-error);
			}

			.input-error:empty {
				display: none;
			}

			.input-error.shake {
				animation: error-shake 320ms ease-in-out;
			}

			.results {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				align-items: center;
				gap: 24px;
			}

			.result-card {
				position: relative;
				min-width: 0;
				padding: 24px;
				background: var(--color-surface);
				border: 1px solid var(--color-green);
				border-radius: 12px;
				box-shadow: 0 0 20px rgb(95 237 131 / 12%);
				isolation: isolate;
			}

			.result-card::before,
			.result-card::after {
				position: absolute;
				z-index: -1;
				inset: 0;
				border-radius: inherit;
				content: '';
				pointer-events: none;
			}

			.result-card::before {
				background: linear-gradient(
					110deg,
					transparent 20%,
					rgb(95 237 131 / 9%) 45%,
					rgb(138 43 226 / 12%) 50%,
					transparent 75%
				);
				background-size: 240% 100%;
				animation: card-shine 6s linear infinite;
			}

			.result-card::after {
				inset: -1px;
				box-shadow: 0 0 22px rgb(138 43 226 / 15%);
			}

			.result-content h2 {
				overflow-wrap: anywhere;
				color: var(--color-green);
				font-size: 1.1rem;
			}

			.total {
				font-size: 1.2rem;
				color: var(--color-green);
			}

			.date-range {
				font-size: 0.85rem;
			}

			.versus {
				padding: 12px;
				color: transparent;
				background: linear-gradient(120deg, var(--color-green), var(--color-purple), var(--color-green));
				background-size: 220% 220%;
				background-clip: text;
				filter: drop-shadow(0 0 10px var(--color-purple));
				animation: versus-pulse 900ms ease-in-out infinite, versus-gradient 4s linear infinite;
			}

			.loading {
				color: var(--color-green);
				animation: loading-pulse 900ms ease-in-out infinite;
			}

			.countdown-overlay {
				position: fixed;
				z-index: 20;
				inset: 0;
				display: grid;
				place-items: center;
				color: var(--color-green);
				background: rgb(10 10 26 / 92%);
				font-size: clamp(2rem, 10vw, 5rem);
				text-shadow: 0 0 24px var(--color-green);
				animation: countdown-flash 1s ease-in-out infinite alternate;
			}

			.winner-banner {
				margin: 36px auto;
				color: var(--color-green);
				font-size: clamp(1.2rem, 4vw, 2rem);
				text-shadow: 0 0 16px var(--color-green);
				animation: winner-reveal 700ms cubic-bezier(0.2, 1.6, 0.4, 1) both;
			}

			.streak {
				color: var(--color-text);
				font-size: 0.8rem;
			}

			.longest-streak {
				color: var(--color-green);
				text-shadow: 0 0 10px var(--color-green);
			}

			.legend {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				margin-top: 14px;
				font: 9px Arial, sans-serif;
			}

			.legend-swatches {
				display: inline-flex;
				gap: 3px;
			}

			.legend-swatch {
				width: 12px;
				height: 12px;
				border-radius: 2px;
			}

			.share-controls {
				margin: 0 auto 40px;
			}

			.share-controls button {
				width: auto;
			}

			#share-feedback {
				min-height: 1.8em;
				color: var(--color-green);
			}

			.history {
				margin-top: 56px;
				text-align: left;
			}

			.history h2 {
				color: var(--color-purple);
				font-size: 1rem;
				text-align: center;
			}

			#battle-history {
				display: grid;
				gap: 10px;
				padding-left: 24px;
				font: 12px/1.8 Arial, sans-serif;
			}

			#battle-history time {
				display: block;
				color: var(--color-purple);
				font-size: 0.85em;
			}

			#clear-history {
				display: block;
				margin: 18px auto;
			}

			.graph-viewport {
				overflow-x: auto;
				padding-bottom: 8px;
			}

			.contribution-graph {
				display: grid;
				grid-template-rows: repeat(7, 12px);
				grid-auto-flow: column;
				gap: 3px;
				width: max-content;
				margin: 24px auto 0;
			}

			.contribution-day {
				position: relative;
				width: 12px;
				height: 12px;
				border-radius: 2px;
				transition: transform 120ms ease, box-shadow 120ms ease;
			}

			.contribution-day:hover,
			.contribution-day:focus-visible {
				z-index: 1;
				transform: scale(1.35);
				box-shadow: 0 0 10px currentColor;
			}

			.contribution-day::after {
				position: absolute;
				bottom: calc(100% + 8px);
				left: 50%;
				z-index: 2;
				width: max-content;
				padding: 6px 8px;
				color: var(--color-text);
				background: var(--color-background);
				border: 1px solid var(--color-green);
				border-radius: 4px;
				content: attr(data-tooltip);
				font: 9px Arial, sans-serif;
				opacity: 0;
				pointer-events: none;
				transform: translate(-50%, 4px);
				transition: opacity 120ms ease, transform 120ms ease;
			}

			.contribution-day:hover::after,
			.contribution-day:focus-visible::after {
				opacity: 1;
				transform: translate(-50%, 0);
			}

			@keyframes title-pulse {
				0%,
				100% {
					filter: brightness(1);
				}
				50% {
					filter: brightness(1.35);
				}
			}

			@keyframes electric-flicker {
				0%,
				96%,
				98%,
				100% {
					opacity: 1;
				}
				97%,
				99% {
					opacity: 0.72;
				}
			}

			@keyframes versus-pulse {
				50% {
					transform: scale(1.25);
					filter: drop-shadow(0 0 18px var(--color-purple));
				}
			}

			@keyframes versus-gradient {
				to {
					background-position: 220% 0;
				}
			}

			@keyframes card-shine {
				to {
					background-position: -240% 0;
				}
			}

			@keyframes float-in {
				from {
					opacity: 0;
					transform: translateY(14px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes loading-pulse {
				50% {
					color: var(--color-purple);
					text-shadow: 0 0 12px var(--color-purple);
				}
			}

			@keyframes error-shake {
				25% {
					transform: translateX(-5px);
				}
				75% {
					transform: translateX(5px);
				}
			}

			@keyframes countdown-flash {
				to {
					color: var(--color-purple);
					text-shadow: 0 0 36px var(--color-purple);
					transform: scale(1.08);
				}
			}

			@keyframes winner-reveal {
				from {
					opacity: 0;
					transform: scale(0.55) translateY(20px);
				}
				to {
					opacity: 1;
					transform: scale(1) translateY(0);
				}
			}

			@media (max-width: 1024px) {
				.results {
					grid-template-columns: minmax(0, 1fr);
				}

				.versus {
					justify-self: center;
				}
			}

			@media (max-width: 768px) {
				:root {
					font-size: 10px;
				}

				.arena {
					padding: 40px 16px;
				}

				.players {
					flex-direction: column;
					gap: 12px;
				}

				.result-card {
					padding: 16px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					scroll-behavior: auto !important;
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</body>
</html>
